.page-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a3a5c;
}

.section {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 20rpx;
}

.type-grid {
  display: flex;
  gap: 20rpx;
}

.type-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.type-item.active {
  border-color: #1a3a5c;
  background: #e8f4ff;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.type-label {
  font-size: 26rpx;
  color: #666;
}

.type-item.active .type-label {
  color: #1a3a5c;
  font-weight: bold;
}

.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 10rpx;
}

.input {
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.input:last-child {
  margin-bottom: 0;
}

.location-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.flex1 {
  flex: 1;
}

.location-btn {
  background: #1a3a5c;
  color: #fff;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  white-space: nowrap;
}

.picker-show {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag-item {
  padding: 10rpx 20rpx;
  background: #f5f5f5;
  border-radius: 50rpx;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.tag-item.active {
  background: #1a3a5c;
  color: #fff;
}

.submit-wrap {
  padding: 40rpx 30rpx;
}

.submit-btn {
  background: #1a3a5c;
  color: #fff;
  border-radius: 50rpx;
  padding: 26rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.submit-btn.disabled {
  background: #ccc;
}