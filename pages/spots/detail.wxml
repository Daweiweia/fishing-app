<view class="container">
  <!-- 顶部地图 -->
  <view class="map-wrapper">
    <map
      id="spot-map"
      class="map"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="14"
      markers="{{markers}}"
      show-location
    ></map>
    <view class="back-btn" bindtap="onBack">
      <text>← 返回</text>
    </view>
  </view>

  <!-- 钓点信息卡片 -->
  <view class="spot-card">
    <view class="spot-header">
      <view class="spot-icon" style="background:{{spot.bgColor}}">{{spot.icon}}</view>
      <view class="spot-title">
        <text class="spot-name">{{spot.name}}</text>
        <view class="rating-row">
          <text class="rating">⭐ {{spot.rating}} {{spot.ratingStars}}</text>
          <text class="checkins">👤 {{spot.checkinCount}}人去过</text>
        </view>
      </view>
    </view>

    <view class="spot-tags">
      <text class="tag" wx:for="{{spot.tags}}" wx:key="*this">{{item}}</text>
    </view>

    <view class="info-list">
      <view class="info-row">
        <text class="info-icon">📍</text>
        <text class="info-value">{{spot.address}}</text>
      </view>
      <view class="info-row" wx:if="{{spot.fishTypes}}">
        <text class="info-icon">🐟</text>
        <text class="info-value">{{spot.fishTypes}}</text>
      </view>
      <view class="info-row" wx:if="{{spot.bait}}">
        <text class="info-icon">🎣</text>
        <text class="info-value">{{spot.bait}}</text>
      </view>
      <view class="info-row" wx:if="{{spot.openHours}}">
        <text class="info-icon">⏰</text>
        <text class="info-value">{{spot.openHours}}</text>
      </view>
      <view class="info-row" wx:if="{{spot.price}}">
        <text class="info-icon">💰</text>
        <text class="info-value">{{spot.price}}</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar">
    <view class="action-btn outline" bindtap="onNavigate">
      <text>🗺️ 导航到这</text>
    </view>
    <view class="action-btn primary" bindtap="onCheckin">
      <text>📍 打卡</text>
    </view>
    <view class="action-btn outline" bindtap="onCollect">
      <text>⭐ 收藏</text>
    </view>
  </view>

  <!-- 鱼获记录 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">📸 钓点鱼获</text>
      <text class="more">更多 ></text>
    </view>
    <view class="catch-list" wx:if="{{catchList.length > 0}}">
      <view class="catch-item" wx:for="{{catchList}}" wx:key="id">
        <view class="catch-icon">{{item.icon}}</view>
        <view class="catch-info">
          <text class="fish-name">{{item.fishName}}</text>
          <text class="catch-meta">{{item.size}}cm · {{item.weight}}kg</text>
        </view>
        <text class="catch-user">{{item.userName}}</text>
      </view>
    </view>
    <view class="empty" wx:else>
      <text>暂无鱼获记录</text>
    </view>
  </view>

  <!-- 钓点点评 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">💬 钓点点评</text>
      <text class="more" bindtap="onMoreReviews">更多 ></text>
    </view>

    <!-- 写点评 -->
    <view class="review-input-box">
      <view class="rating-row">
        <text class="rating-label">评分：</text>
        <view class="stars-row">
          <text
            wx:for="{{[1,2,3,4,5]}}"
            wx:key="*this"
            class="star {{reviewRating >= item ? 'active' : ''}}"
            data-val="{{item}}"
            catchtap="onReviewStarChange"
          >★</text>
        </view>
        <text class="rating-val">{{reviewRating}}分</text>
      </view>
      <textarea
        class="review-textarea"
        placeholder="分享你的钓鱼体验..."
        maxlength="500"
        bindinput="onReviewInput"
        value="{{reviewText}}"
      />
      <view class="review-submit-row">
        <text class="char-count">{{reviewText.length}}/500</text>
        <button class="submit-btn" bindtap="onSubmitReview">发布</button>
      </view>
    </view>

    <!-- 点评列表 -->
    <view class="review-list" wx:if="{{reviews.length > 0}}">
      <view class="review-item" wx:for="{{reviews}}" wx:key="id">
        <view class="review-header">
          <image class="review-avatar" src="{{item.user_avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
          <view class="review-user-info">
            <text class="review-user-name">{{item.user_name}}</text>
            <view class="review-meta">
              <text class="review-rating">★ {{item.rating}}</text>
              <text class="review-time">{{item.created_at}}</text>
            </view>
          </view>
        </view>
        <view class="review-content">{{item.content}}</view>
        <view class="review-fish" wx:if="{{item.fish_result}}">🐟 {{item.fish_result}}</view>
      </view>
    </view>
    <view class="empty" wx:else>
      <text>暂无点评，来说两句？</text>
    </view>
  </view>
</view>