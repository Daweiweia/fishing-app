.publish-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.publish-bar .user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.publish-bar .placeholder {
  margin-left: 20rpx;
  color: #999;
  font-size: 28rpx;
}

.topic-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.topic-list {
  display: inline-flex;
  padding: 0 20rpx;
  gap: 16rpx;
}

.topic-item {
  padding: 10rpx 24rpx;
  background: #f5f5f5;
  border-radius: 50rpx;
  font-size: 26rpx;
  color: #666;
}

.topic-item.active {
  background: #1a3a5c;
  color: #fff;
}

.post-list {
  padding: 0 30rpx;
}

.post-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-info {
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.post-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.post-content {
  margin-bottom: 20rpx;
}

.post-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.post-images {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.post-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  background: #ddd;
}

.post-actions {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #666;
  font-size: 26rpx;
}