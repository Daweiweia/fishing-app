<view class="container">
  <!-- 用户信息 -->
  <view class="user-card" bindtap="onLoginTap">
    <view class="card-bg"></view>
    <view class="user-info">
      <view class="avatar-wrap">
        <image wx:if="{{userInfo.avatar}}" class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill" />
        <view wx:if="{{!userInfo.avatar}}" class="avatar-placeholder">
          <text>{{loggedIn ? userInfo.userIcon : '🎣'}}</text>
        </view>
        <view class="avatar-ring"></view>
      </view>
      <view class="info">
        <text class="nickname">{{loggedIn ? userInfo.nickname : '点击登录'}}</text>
        <text class="bio" wx:if="{{loggedIn}}">{{userInfo.bio || '钓鱼爱好者'}}</text>
        <text class="bio" wx:if="{{!loggedIn}}">登录后同步你的鱼获、钓点数据</text>
      </view>
    </view>

    <!-- 统计 -->
    <view class="user-stats" wx:if="{{loggedIn}}">
      <view class="stat-item">
        <view class="stat-icon">🐟</view>
        <text class="stat-num">{{userInfo.fishCount}}</text>
        <text class="stat-label">鱼种</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-icon">📸</view>
        <text class="stat-num">{{userInfo.catchCount}}</text>
        <text class="stat-label">鱼获</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-icon">📍</view>
        <text class="stat-num">{{userInfo.spotCount}}</text>
        <text class="stat-label">钓点</text>
      </view>
    </view>

    <!-- 未登录提示 -->
    <view class="unlogin-bar" wx:if="{{!loggedIn}}">
      <text>登录解锁完整功能</text>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-section">
    <view class="menu-card">
      <view class="menu-item" bindtap="goToMySpots">
        <view class="menu-left">
          <view class="menu-icon-wrap blue">
            <text class="menu-icon">📍</text>
          </view>
          <text class="menu-text">我的钓点</text>
        </view>
        <view class="menu-right">
          <text class="menu-count" wx:if="{{loggedIn && userInfo.spotCount > 0}}">{{userInfo.spotCount}}</text>
          <text class="arrow">›</text>
        </view>
      </view>

      <view class="menu-item" bindtap="goToMyCatches">
        <view class="menu-left">
          <view class="menu-icon-wrap green">
            <text class="menu-icon">📸</text>
          </view>
          <text class="menu-text">我的鱼获</text>
        </view>
        <view class="menu-right">
          <text class="menu-count" wx:if="{{loggedIn && userInfo.catchCount > 0}}">{{userInfo.catchCount}}</text>
          <text class="arrow">›</text>
        </view>
      </view>

      <view class="menu-item" bindtap="goToMyPosts">
        <view class="menu-left">
          <view class="menu-icon-wrap orange">
            <text class="menu-icon">📝</text>
          </view>
          <text class="menu-text">我的帖子</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="menu-card">
      <view class="menu-item" bindtap="goToSettings">
        <view class="menu-left">
          <view class="menu-icon-wrap gray">
            <text class="menu-icon">⚙️</text>
          </view>
          <text class="menu-text">设置</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>
</view>