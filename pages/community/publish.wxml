<view class="container">
  <view class="page-header">
    <text class="page-title">📝 发布帖子</text>
  </view>

  <!-- 话题选择 -->
  <view class="section">
    <text class="section-label">选择话题</text>
    <view class="topic-list">
      <view class="topic-item {{selectedTopic === item.key ? 'active' : ''}}" 
            wx:for="{{topics}}" wx:key="key"
            data-key="{{item.key}}" bindtap="onTopicTap">
        {{item.label}}
      </view>
    </view>
  </view>

  <!-- 内容输入 -->
  <view class="section">
    <textarea class="content-input" placeholder="分享你的钓鱼心得..." 
              value="{{content}}" bindinput="onContentInput" maxlength="500" />
    <text class="char-count">{{content.length}}/500</text>
  </view>

  <!-- 图片上传 -->
  <view class="section">
    <view class="image-list">
      <view class="image-item" wx:for="{{images}}" wx:key="*this">
        <image class="preview-img" src="{{item}}" mode="aspectFill" />
        <text class="remove-btn" data-idx="{{index}}" bindtap="onRemoveImage">×</text>
      </view>
      <view class="add-image-btn" bindtap="onAddImage" wx:if="{{images.length < 9}}">
        <text>+</text>
        <text class="add-text">添加图片</text>
      </view>
    </view>
  </view>

  <!-- 发布按钮 -->
  <view class="submit-btn-wrap">
    <button class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '发布中...' : '发布帖子'}}
    </button>
  </view>
</view>