.map-wrapper {
  height: 35vh;
  position: relative;
}

.map {
  width: 100%;
  height: 100%;
}

.back-btn {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: #fff;
  padding: 12rpx 24rpx;
  border-radius: 50rpx;
  font-size: 26rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.spot-card {
  margin: -30rpx 30rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.spot-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.spot-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  flex-shrink: 0;
}

.spot-title {
  flex: 1;
}

.spot-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.rating-row {
  display: flex;
  gap: 20rpx;
}

.rating {
  font-size: 26rpx;
  color: #666;
}

.checkins {
  font-size: 26rpx;
  color: #666;
}

.spot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.tag {
  background: #e8f4ff;
  color: #1a3a5c;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.info-list {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  gap: 16rpx;
}

.info-icon {
  font-size: 28rpx;
  width: 40rpx;
  text-align: center;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 50rpx;
  font-size: 28rpx;
}

.action-btn.primary {
  background: #1a3a5c;
  color: #fff;
}

.action-btn.outline {
  border: 2rpx solid #1a3a5c;
  color: #1a3a5c;
  background: #fff;
}

.section {
  padding: 0 30rpx 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a3a5c;
}

.more {
  font-size: 24rpx;
  color: #999;
}

.catch-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.catch-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.catch-icon {
  font-size: 48rpx;
}

.catch-info {
  flex: 1;
}

.fish-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.catch-meta {
  font-size: 24rpx;
  color: #999;
}

.catch-user {
  font-size: 24rpx;
  color: #999;
}

.empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

/* 点评样式 */
.review-input-box {
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.rating-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.rating-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 10rpx;
}

.stars-row {
  display: flex;
  gap: 4rpx;
}

.star {
  font-size: 36rpx;
  color: #ccc;
  line-height: 1;
}

.star.active {
  color: #ffb800;
}

.rating-val {
  font-size: 26rpx;
  color: #ffb800;
  margin-left: 12rpx;
}

.review-textarea {
  width: 100%;
  height: 120rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid #eee;
}

.review-submit-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.char-count {
  font-size: 22rpx;
  color: #999;
}

.submit-btn {
  background: #1a3a5c;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  border: none;
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.review-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.review-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.review-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #e0e0e0;
}

.review-user-info {
  flex: 1;
}

.review-user-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.review-meta {
  display: flex;
  gap: 16rpx;
}

.review-rating {
  font-size: 24rpx;
  color: #ffb800;
}

.review-time {
  font-size: 24rpx;
  color: #999;
}

.review-content {
  font-size: 28rpx;
  color: #444;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.review-fish {
  font-size: 24rpx;
  color: #1a3a5c;
  background: #e8f4ff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  display: inline-block;
}