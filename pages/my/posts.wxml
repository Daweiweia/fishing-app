<view class="container">
  <view class="page-header">
    <text class="page-title">📝 我的帖子</text>
  </view>

  <view class="post-list" wx:if="{{!loading && posts.length > 0}}">
    <view class="post-item" wx:for="{{posts}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="post-tags" wx:if="{{item.topic}}">
        <text class="tag">#{{item.topic}}</text>
      </view>
      <text class="post-content">{{item.content}}</text>
      <view class="post-images" wx:if="{{item.images && item.images.length > 0}}">
        <image class="post-img" src="{{img}}" mode="aspectFill" wx:for="{{item.images}}" wx:key="*this"/>
      </view>
      <view class="post-footer">
        <text class="post-time">{{item.time}}</text>
        <view class="post-stats">
          <text>❤️ {{item.likes}}</text>
          <text>💬 {{item.comments}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && posts.length === 0}}">
    <text class="empty-icon">📝</text>
    <text class="empty-text">还没有发布任何帖子</text>
    <text class="empty-hint">快去社区分享吧</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>