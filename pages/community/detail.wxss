.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #1a3a5c;
  color: #fff;
}

.back-btn {
  font-size: 28rpx;
  width: 100rpx;
}

.nav-title {
  font-size: 32rpx;
  font-weight: bold;
}

.post-scroll {
  flex: 1;
  height: calc(100vh - 100rpx - 120rpx);
}

.post-card {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.post-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e8f4ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.avatar.small {
  width: 60rpx;
  height: 60rpx;
  font-size: 30rpx;
}

.user-info {
  flex: 1;
}

.username {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.post-time {
  font-size: 24rpx;
  color: #999;
}

.post-content {
  margin-bottom: 20rpx;
}

.post-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.post-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
}

.post-tags {
  margin-bottom: 16rpx;
}

.tag {
  background: #e8f4ff;
  color: #1a3a5c;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.post-actions {
  display: flex;
  gap: 40rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.icon {
  font-size: 32rpx;
}

/* 评论区 */
.comment-section {
  background: #fff;
  padding: 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a3a5c;
}

.comment-count {
  font-size: 24rpx;
  color: #999;
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.comment-item {
  display: flex;
  flex-direction: column;
}

.comment-main {
  display: flex;
  gap: 16rpx;
}

.comment-body {
  flex: 1;
}

.comment-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.commenter-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-content {
  font-size: 28rpx;
  color: #444;
  line-height: 1.5;
  display: block;
  margin-bottom: 8rpx;
}

.comment-actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.action-text {
  font-size: 24rpx;
  color: #666;
}

/* 回复列表 */
.reply-list {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 8rpx;
}

.reply-item {
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.reply-name {
  color: #1a3a5c;
  font-weight: bold;
}

.reply-name.to {
  color: #666;
}

.reply-arrow {
  color: #999;
}

.reply-content {
  color: #444;
}

/* 底部评论输入框 */
.comment-input-box {
  background: #fff;
  border-top: 1rpx solid #eee;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.comment-input-box.has-reply {
  border-top: 2rpx solid #1a3a5c;
}

.reply-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #1a3a5c;
  margin-bottom: 12rpx;
  background: #e8f4ff;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
}

.cancel-reply {
  color: #999;
  font-size: 24rpx;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.send-btn {
  background: #1a3a5c;
  color: #fff;
  font-size: 28rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  border: none;
}

.empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}