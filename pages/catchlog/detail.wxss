.fish-card {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.fish-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-right: 24rpx;
}

.fish-info {
  flex: 1;
}

.fish-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.fish-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.stat {
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.fish-date {
  font-size: 24rpx;
  color: #999;
}

.content-section {
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
}

.content-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.image-section {
  margin: 0 30rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.catch-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 8rpx;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #999;
}