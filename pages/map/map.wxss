.search-bar {
  display: flex;
  padding: 20rpx 30rpx;
  background: #fff;
  gap: 20rpx;
  position: relative;
  z-index: 100;
}

.search-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 50rpx;
  padding: 16rpx 30rpx;
  font-size: 28rpx;
}

.search-btn {
  background: #1a3a5c;
  color: #fff;
  padding: 16rpx 30rpx;
  border-radius: 50rpx;
  font-size: 26rpx;
  line-height: 1;
}

.map-wrapper {
  height: 50vh;
  position: relative;
}

.map {
  width: 100%;
  height: 100%;
}

.bottom-sheet {
  height: 50vh;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.1);
  display: flex;
  flex-direction: column;
}

.sheet-handle {
  display: flex;
  justify-content: center;
  padding: 10rpx 0 20rpx;
}

.handle-bar {
  width: 80rpx;
  height: 8rpx;
  background: #ddd;
  border-radius: 4rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a3a5c;
  margin-bottom: 20rpx;
}

.spot-list {
  flex: 1;
  height: 0;
}

.spot-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 16rpx;
}

.spot-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.spot-info {
  flex: 1;
}

.spot-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.spot-address {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 6rpx;
}

.spot-tags {
  display: flex;
  gap: 8rpx;
}

.tag {
  background: #e8f4ff;
  color: #1a3a5c;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}

.spot-meta {
  flex-shrink: 0;
}

.rating {
  font-size: 24rpx;
  color: #666;
}

.spot-detail {
  flex: 1;
}

.detail-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.detail-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.detail-title {
  flex: 1;
}

.detail-title .name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.detail-title .rating {
  font-size: 24rpx;
  color: #666;
}

.close-btn {
  font-size: 32rpx;
  color: #999;
  padding: 10rpx;
}

.detail-content {
  flex: 1;
}

.detail-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-row .label {
  font-size: 26rpx;
  color: #666;
  width: 160rpx;
  flex-shrink: 0;
}

.detail-row .value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.detail-actions {
  display: flex;
  gap: 20rpx;
  padding-top: 20rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 50rpx;
  font-size: 28rpx;
  background: #f5f5f5;
  color: #333;
}

.action-btn.primary {
  background: #1a3a5c;
  color: #fff;
}